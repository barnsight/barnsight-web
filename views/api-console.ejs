<!doctype html>
<html lang="<%= locale %>">
  <head>
    <%- include("partials/head") %>
    <title><%= t("api.title") %></title>
  </head>
  <body class="page-transition font-sans">
    <header class="brand-header">
      <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-3 px-6 py-4">
        <div>
          <a href="/" class="brand-link">
            <img class="brand-logo" src="/assets/brand/logo-t.png" alt="BarnSight logo" />
            <span>BarnSight</span>
          </a>
          <p class="mt-1 text-xs text-ink-mute"><%= locale === "uk" ? "API Консоль" : "API Console" %> · <%= t("dashboard.role") %> <%= role %></p>
        </div>
        <div class="flex items-center gap-3">
          <%- include("partials/language-switcher") %>
          <%- include("partials/theme-toggle") %>
          <a href="/dashboard" class="btn-secondary"><%= t("nav.dashboard") %></a>
          <form action="/logout" method="post">
            <button class="btn-primary" type="submit"><%= t("nav.logout") %></button>
          </form>
        </div>
      </div>
    </header>

    <main class="mx-auto grid max-w-7xl gap-6 px-6 py-8 xl:grid-cols-[0.95fr_1.05fr]">
      <section>
        <div class="panel p-5">
          <h1 class="font-display text-2xl font-bold"><%= t("api.subtitle") %></h1>
          <p class="mt-2 text-sm text-ink-soft">
            <%= t("api.lead") %>
          </p>
        </div>
        <div id="endpointList" class="mt-4 space-y-4"></div>
      </section>

      <section class="panel sticky top-4 self-start p-5">
        <h2 class="font-display text-xl font-semibold"><%= t("api.request") %></h2>
        <form id="apiRequestForm" class="mt-4 space-y-4">
          <div class="grid gap-3 md:grid-cols-[140px_1fr]">
            <div>
              <label class="mb-1 block text-sm text-ink-soft" for="method"><%= locale === "uk" ? "Метод" : "Method" %></label>
              <select id="method" class="field">
                <option>GET</option>
                <option>POST</option>
                <option>PUT</option>
                <option>PATCH</option>
                <option>DELETE</option>
              </select>
            </div>
            <div>
              <label class="mb-1 block text-sm text-ink-soft" for="path"><%= locale === "uk" ? "Шлях" : "Path" %></label>
              <input id="path" class="field font-mono" placeholder="/api-keys" required />
            </div>
          </div>

          <div>
            <label class="mb-1 block text-sm text-ink-soft" for="apiKey"><%= t("api.edgeKey") %></label>
            <input id="apiKey" class="field font-mono" placeholder="<%= locale === 'uk' ? 'Опційно: bs_...' : 'Optional: bs_...' %>" />
          </div>

          <div>
            <label class="mb-1 block text-sm text-ink-soft" for="body"><%= t("api.body") %></label>
            <textarea id="body" class="field min-h-56 font-mono text-xs" spellcheck="false"></textarea>
          </div>

          <button class="btn-primary w-full" type="submit"><%= t("api.submit") %></button>
        </form>

        <div class="mt-5">
          <h2 class="font-display text-xl font-semibold"><%= t("api.response") %></h2>
          <pre id="responseOutput" class="mt-3 max-h-[34rem] overflow-auto rounded-[12px_22px_14px_24px] border border-edge/45 bg-ink/95 p-3 font-mono text-xs text-paper"></pre>
        </div>
      </section>
    </main>

    <script src="/public/pageTransitions.js"></script>
    <script>window.APP_LOCALE = "<%= locale %>";</script>
    <script src="/public/site.js"></script>
    <script src="/public/apiConsole.js"></script>
  </body>
</html>
