<!doctype html>
<html lang="<%= locale %>">
  <head>
    <%- include("partials/head") %>
    <title><%= t("faq.title") %></title>
  </head>
  <body class="page-transition font-sans">
    <header class="brand-header">
      <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-3 px-6 py-4">
        <a href="/" class="brand-link">
          <img class="brand-logo" src="/assets/brand/logo-t.png" alt="BarnSight logo" />
          <span>BarnSight</span>
        </a>
        <nav class="flex flex-wrap items-center gap-3">
          <%- include("partials/language-switcher") %>
          <%- include("partials/theme-toggle") %>
          <a href="/about" class="text-sm font-medium text-ink-soft hover:text-ochre-deep"><%= t("nav.about") %></a>
          <a href="/pricing" class="text-sm font-medium text-ink-soft hover:text-ochre-deep"><%= t("nav.pricing") %></a>
          <% if (currentUser) { %>
          <a href="/dashboard" class="btn-secondary"><%= t("nav.dashboard") %></a>
          <% } else { %>
          <a href="/register" class="btn-secondary"><%= t("nav.register") %></a>
          <a href="/login" class="btn-primary"><%= t("nav.login") %></a>
          <% } %>
        </nav>
      </div>
    </header>

    <main class="mx-auto max-w-6xl px-6 py-14 sm:py-18">
      <span class="chip">FAQ</span>
      <h1 class="mt-6 font-display text-5xl font-extrabold leading-[0.92] tracking-tight text-ink sm:text-6xl">
        <%= t("faq.heading") %>
        <span class="ink-underline italic text-ochre-deep">?</span>
      </h1>

      <section class="mt-12 space-y-4">
        <%
          const faqItems = locale === "en"
            ? [
                ["What does BarnSight actually do?", "BarnSight monitors barn cleanliness through camera-based detection, organized event review, and operational reporting. It is designed to help teams notice contamination earlier and respond with better context."],
                ["Is BarnSight meant to replace people on site?", "No. BarnSight is built to support human judgment. Teams still review detections, inspect conditions, and make decisions. The platform reduces delay and inconsistency; it does not replace accountability."],
                ["Can it work in difficult farm conditions?", "Yes. The platform is designed for uneven lighting, unstable connectivity, and practical field deployment. Edge processing and resilient ingestion reduce dependence on ideal network conditions."],
                ["Who is BarnSight for?", "It is built for farmers, inspectors, managers, and technical teams that need a reliable way to review hygiene events across barns, devices, and staff workflows."],
                ["How does the web dashboard help operations?", "The dashboard brings events, analytics, reports, profile tools, and device-facing workflows into one place so the operational team can review what happened and act faster."],
                ["Can BarnSight scale beyond a single barn?", "Yes. The system architecture is intended for multiple barns, multiple devices, and ongoing model adaptation as conditions change across sites."],
              ]
            : [
                ["Що саме робить BarnSight?", "BarnSight контролює чистоту корівників через детекцію з камер, організований перегляд подій і операційні звіти. Платформа допомагає помічати забруднення раніше та реагувати з кращим контекстом."],
                ["Чи замінює BarnSight людей на фермі?", "Ні. BarnSight створений для підтримки людського рішення. Команда все одно переглядає детекції, оцінює умови та приймає дії. Платформа зменшує затримки й хаос, але не прибирає відповідальність."],
                ["Чи працює система у складних умовах ферми?", "Так. Платформа спроєктована для нерівномірного освітлення, нестабільного зв’язку та реального польового середовища. Edge-обробка і стійке приймання подій зменшують залежність від ідеальної мережі."],
                ["Для кого створено BarnSight?", "Система орієнтована на фермерів, інспекторів, менеджерів і технічні команди, яким потрібен надійний спосіб перегляду гігієнічних подій у межах barns, devices і робочих процесів персоналу."],
                ["Як вебпанель допомагає операційній роботі?", "Панель збирає події, аналітику, звіти, профільні інструменти та робочі сценарії для edge-пристроїв в одному місці, щоб команда швидше розуміла ситуацію і діяла без зайвих перемикань."],
                ["Чи можна масштабувати BarnSight на кілька господарств?", "Так. Архітектура системи розрахована на кілька корівників, кілька пристроїв і поступову адаптацію моделей під різні умови на різних локаціях."],
              ];
        %>
        <% faqItems.forEach((item, i) => { %>
        <details class="faq-item reveal <%= i === 0 ? '' : (i % 2 ? 'tilt-n1' : 'tilt-1') %>" <%= i === 0 ? "open" : "" %>>
          <summary>
            <span><%= item[0] %></span>
            <svg class="chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M6 9l6 6 6-6" />
            </svg>
          </summary>
          <p class="answer"><%= item[1] %></p>
        </details>
        <% }); %>
      </section>

      <section class="mt-20 panel bg-ink/95 px-7 py-8 text-paper shadow-panel-lg reveal">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <div>
            <p class="text-sm uppercase tracking-[0.24em] text-paper/55"><%= locale === "uk" ? "Додатково" : "More" %></p>
            <p class="mt-4 max-w-3xl text-sm leading-8 text-paper/72">
              <%= locale === "uk"
                ? "Для деталей про продукт, інженерний напрямок і репозиторії використовуйте GitHub-організацію BarnSight та операційні сторінки цього сайту."
                : "For product context, engineering direction, and project repositories, use the BarnSight GitHub organization and the operational pages across this website." %>
            </p>
          </div>
          <a href="https://github.com/barnsight" target="_blank" rel="noreferrer" class="btn-secondary border-paper/25 bg-paper/10 text-paper">GitHub</a>
        </div>
      </section>
    </main>
    <script src="/public/pageTransitions.js"></script>
    <script src="/public/site.js"></script>
  </body>
</html>
