<!doctype html>
<html lang="<%= locale %>">
  <head>
    <%- include("partials/head") %>
    <title><%= locale === "uk" ? "Скидання пароля - BarnSight" : "Reset password - BarnSight" %></title>
  </head>
  <body class="page-transition font-sans">
    <main class="mx-auto flex min-h-screen max-w-5xl items-center px-6 py-12">
      <section class="panel mx-auto max-w-2xl p-8">
        <img class="brand-logo h-16 w-16 rounded-2xl" src="/assets/brand/logo-t.png" alt="BarnSight logo" />
        <h1 class="mt-5 font-display text-4xl font-bold text-ink">
          <%= locale === "uk" ? "Скидання пароля" : "Reset password" %>
        </h1>
        <p class="mt-4 text-sm leading-7 text-ink-soft">
          <%= locale === "uk"
            ? "Окремий токенізований reset flow ще не підтримується BarnSight API. Ця сторінка залишена як цільовий інтерфейс для майбутньої backend інтеграції."
            : "A tokenized reset flow is not yet supported by the current BarnSight API. This page remains as the target UI for a future backend integration." %>
        </p>
        <div class="notice mt-5">
          <p class="font-semibold text-ink"><%= locale === "uk" ? "Що вже працює" : "What already works" %></p>
          <p class="mt-1 text-sm text-ink-soft">
            <%= locale === "uk"
              ? "Після входу можна змінити пароль через Profile -> Change password або Recovery reset."
              : "After login, you can already change the password through Profile -> Change password or Recovery reset." %>
          </p>
        </div>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href="/login" class="btn-primary"><%= locale === "uk" ? "До входу" : "Go to login" %></a>
          <a href="/dashboard" class="btn-secondary"><%= locale === "uk" ? "До панелі" : "Go to dashboard" %></a>
        </div>
      </section>
    </main>
    <script src="/public/pageTransitions.js"></script>
    <script src="/public/site.js"></script>
  </body>
</html>
