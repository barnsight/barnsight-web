<!doctype html>
<html lang="uk">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Панель — BarnSight</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/assets/styles.css" />
  </head>
  <body class="page-transition font-sans">
    <header class="border-b border-zinc-800">
      <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-3 px-6 py-4">
        <div>
          <a href="/" class="text-lg font-semibold">BarnSight</a>
          <p class="text-xs text-zinc-400">Роль: <%= role %></p>
        </div>
        <div class="flex items-center gap-3">
          <button id="refreshBtn" class="btn-secondary">Оновити дані</button>
          <form action="/logout" method="post">
            <button class="btn-primary" type="submit">Вийти</button>
          </form>
        </div>
      </div>
    </header>

    <main class="mx-auto max-w-7xl space-y-6 px-6 py-8">
      <section class="grid gap-4 lg:grid-cols-4">
        <article class="panel p-4">
          <p class="text-sm text-zinc-400">Користувач</p>
          <h2 id="meName" class="mt-1 text-xl font-semibold">...</h2>
        </article>
        <article class="panel p-4">
          <p class="text-sm text-zinc-400">Господарств</p>
          <h2 id="barnCount" class="mt-1 text-xl font-semibold">0</h2>
        </article>
        <article class="panel p-4">
          <p class="text-sm text-zinc-400">Подій (фільтр)</p>
          <h2 id="eventCount" class="mt-1 text-xl font-semibold">0</h2>
        </article>
        <article class="panel p-4">
          <p class="text-sm text-zinc-400">Тренд</p>
          <h2 id="trend" class="mt-1 text-xl font-semibold">—</h2>
        </article>
      </section>

      <section class="panel p-5">
        <h3 class="text-lg font-semibold">Фільтри періоду</h3>
        <form id="filtersForm" class="mt-4 grid gap-3 md:grid-cols-4">
          <div>
            <label for="startDate" class="mb-1 block text-sm text-zinc-400">Початок</label>
            <input id="startDate" type="date" class="field" />
          </div>
          <div>
            <label for="endDate" class="mb-1 block text-sm text-zinc-400">Кінець</label>
            <input id="endDate" type="date" class="field" />
          </div>
          <div>
            <label for="barnId" class="mb-1 block text-sm text-zinc-400">Barn ID</label>
            <input id="barnId" type="number" class="field" placeholder="Опційно" />
          </div>
          <div class="flex items-end">
            <button id="applyFiltersBtn" type="submit" class="btn-primary w-full">Застосувати</button>
          </div>
        </form>
        <p id="filtersStatus" class="mt-3 text-xs text-zinc-500">Очікування застосування фільтрів.</p>
      </section>

      <section class="grid gap-4 lg:grid-cols-2">
        <article class="panel p-5">
          <h3 class="text-lg font-semibold">Аналітика</h3>
          <pre id="analyticsOut" class="mt-4 max-h-72 overflow-auto rounded-lg border border-zinc-800 bg-zinc-950 p-3 text-xs text-zinc-300"></pre>
        </article>
        <article class="panel p-5">
          <h3 class="text-lg font-semibold">Звіт</h3>
          <pre id="reportOut" class="mt-4 max-h-72 overflow-auto rounded-lg border border-zinc-800 bg-zinc-950 p-3 text-xs text-zinc-300"></pre>
        </article>
      </section>

      <section class="panel p-5">
        <h3 class="text-lg font-semibold">Події детекції</h3>
        <p class="mt-1 text-sm text-zinc-400">Зображення відображаються лише якщо `image_snapshot` присутній у відповіді API.</p>
        <div id="eventsList" class="mt-4 grid gap-4 md:grid-cols-2 xl:grid-cols-3"></div>
      </section>

      <section class="panel p-5">
        <h3 class="text-lg font-semibold">Детекції (raw JSON)</h3>
        <pre id="detectionsOut" class="mt-4 max-h-80 overflow-auto rounded-lg border border-zinc-800 bg-zinc-950 p-3 text-xs text-zinc-300"></pre>
      </section>
    </main>

    <script>
      window.BARNSIGHT_ROLE = "<%= role %>";
    </script>
    <script src="/public/pageTransitions.js"></script>
    <script src="/public/dashboard.js"></script>
  </body>
</html>
