<!doctype html>
<html lang="<%= locale %>">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= t("dashboard.title") %></title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/assets/styles.css" />
  </head>
  <body class="dashboard-page page-transition font-sans">
    <main class="mx-auto max-w-[1780px] px-4 py-4 sm:px-6 lg:px-8">
      <header class="panel p-5 sm:p-6">
        <div class="flex flex-wrap items-start justify-between gap-4">
          <div class="flex items-center gap-3">
            <img class="brand-logo" src="/assets/brand/logo-t.png" alt="BarnSight logo" />
            <div>
              <p class="text-sm uppercase tracking-[0.24em] text-zinc-500">BarnSight</p>
              <h1 class="mt-2 text-3xl font-extrabold tracking-tight text-zinc-950 sm:text-5xl"><%= t("nav.dashboard") %></h1>
              <p class="mt-2 max-w-3xl text-sm leading-7 text-zinc-600">Operational workspace for barns, coworkers, events, edge devices, and review workflows.</p>
            </div>
          </div>
          <div class="flex flex-wrap items-center gap-3">
            <%- include("partials/language-switcher") %>
            <a href="/" class="btn-secondary"><%= t("nav.backHome") %></a>
            <button id="refreshBtn" class="btn-primary"><%= t("dashboard.refresh") %></button>
            <form action="/logout" method="post">
              <button class="btn-secondary" type="submit"><%= t("nav.logout") %></button>
            </form>
          </div>
        </div>

        <div class="mt-6 overflow-x-auto">
          <div id="dashboardTabs" class="flex min-w-max gap-3">
            <button type="button" class="dashboard-tab" data-tab="overview">Overview</button>
            <button type="button" class="dashboard-tab" data-tab="profile">Profile</button>
            <button type="button" class="dashboard-tab" data-tab="keys">API Keys</button>
            <button type="button" class="dashboard-tab" data-tab="barns">Barns</button>
            <button type="button" class="dashboard-tab" data-tab="devices">Devices</button>
            <button type="button" class="dashboard-tab" data-tab="cameras">Cameras &amp; Zones</button>
            <button type="button" class="dashboard-tab" data-tab="events">Events</button>
            <% if (role === "admins") { %>
            <button type="button" class="dashboard-tab" data-tab="admin">Admin</button>
            <% } %>
            <button type="button" class="dashboard-tab" data-tab="system">System</button>
          </div>
        </div>
      </header>

      <section class="mt-4 space-y-4">
        <section data-tab-panel="overview" class="dashboard-panel space-y-4">
          <section class="grid gap-4 md:grid-cols-2 2xl:grid-cols-4">
            <article class="panel p-5">
              <p class="text-sm text-zinc-500"><%= t("dashboard.user") %></p>
              <h2 id="meName" class="mt-3 text-2xl font-bold">...</h2>
              <p id="meUsername" class="mt-1 text-sm text-zinc-600">—</p>
            </article>
            <article class="panel p-5">
              <p class="text-sm text-zinc-500"><%= t("dashboard.barns") %></p>
              <h2 id="barnCount" class="mt-3 text-2xl font-bold">0</h2>
              <p id="deviceCountLabel" class="mt-1 text-sm text-zinc-600">Devices: —</p>
            </article>
            <article class="panel p-5">
              <p class="text-sm text-zinc-500"><%= t("dashboard.events") %></p>
              <h2 id="eventCount" class="mt-3 text-2xl font-bold">0</h2>
              <p id="calendarSummary" class="mt-1 text-sm text-zinc-600">Calendar loading…</p>
            </article>
            <article class="panel p-5">
              <p class="text-sm text-zinc-500"><%= t("dashboard.trend") %></p>
              <h2 id="trend" class="mt-3 text-2xl font-bold">—</h2>
              <p id="apiKeyCountLabel" class="mt-1 text-sm text-zinc-600">API keys: —</p>
            </article>
          </section>

          <section class="panel p-5">
            <div class="flex flex-wrap items-center justify-between gap-4">
              <div>
                <h2 class="text-lg font-semibold"><%= t("dashboard.filters") %></h2>
                <p class="mt-1 text-sm text-zinc-600">Use one date window for analytics, reports, and event review.</p>
              </div>
              <form id="filtersForm" class="grid w-full gap-3 xl:grid-cols-[180px_180px_1fr_180px]">
                <input id="startDate" type="date" class="field" aria-label="<%= t("dashboard.start") %>" />
                <input id="endDate" type="date" class="field" aria-label="<%= t("dashboard.end") %>" />
                <input id="barnId" type="number" class="field" placeholder="Barn ID" />
                <button id="applyFiltersBtn" type="submit" class="btn-primary w-full"><%= t("dashboard.apply") %></button>
              </form>
            </div>
            <p id="filtersStatus" class="mt-3 text-xs text-zinc-600"><%= t("dashboard.waiting") %></p>
          </section>

          <section class="panel p-5">
            <div class="flex flex-wrap items-center justify-between gap-3">
              <div>
                <h2 class="text-lg font-semibold"><%= t("dashboard.analytics") %></h2>
                <p class="mt-1 text-sm text-zinc-600">All values are rendered from the current analytics and report response for the selected period.</p>
              </div>
              <div class="flex gap-4 text-xs text-zinc-600">
                <span><span class="text-amber-600">●</span> Events</span>
                <span><span class="text-zinc-950">●</span> Confidence</span>
              </div>
            </div>
            <div id="analyticsChart" class="mt-5 grid min-h-[280px] gap-3 rounded-[1.5rem] border border-amber-900/10 bg-white/55 p-4 sm:grid-cols-7"></div>
            <div id="analyticsHighlights" class="mt-4 grid gap-3 md:grid-cols-3"></div>
            <p id="analyticsEmptyState" class="mt-4 hidden text-sm text-zinc-500">No analytics data for the selected period.</p>
          </section>
        </section>

        <section data-tab-panel="profile" class="dashboard-panel hidden">
          <article class="panel p-5">
            <div class="flex flex-wrap items-start justify-between gap-3">
              <div>
                <h2 class="text-lg font-semibold">Profile</h2>
                <p class="mt-1 text-sm text-zinc-600">User info, email, and password controls.</p>
              </div>
              <p id="profileStatus" class="text-xs text-zinc-500">Profile ready.</p>
            </div>
            <div id="profileSummary" class="mt-4 grid gap-3 md:grid-cols-2"></div>
            <div class="mt-5 grid gap-4 2xl:grid-cols-2">
              <form id="profileForm" class="rounded-[1.5rem] border border-amber-900/10 bg-white/65 p-4">
                <h3 class="text-lg font-semibold text-zinc-950">Update profile</h3>
                <div class="mt-4 grid gap-3">
                  <input id="profileFirstName" class="field" placeholder="First name" />
                  <input id="profileMiddleName" class="field" placeholder="Middle name" />
                  <input id="profileLastName" class="field" placeholder="Last name" />
                  <button class="btn-primary w-full" type="submit">Save profile</button>
                </div>
              </form>
              <form id="emailForm" class="rounded-[1.5rem] border border-amber-900/10 bg-white/65 p-4">
                <h3 class="text-lg font-semibold text-zinc-950">Update email</h3>
                <div class="mt-4 grid gap-3">
                  <input id="profileEmail" class="field" type="email" placeholder="user@example.com" />
                  <input id="emailPassword" class="field" type="password" placeholder="Current password" />
                  <button class="btn-primary w-full" type="submit">Save email</button>
                </div>
              </form>
              <form id="passwordForm" class="rounded-[1.5rem] border border-amber-900/10 bg-white/65 p-4">
                <h3 class="text-lg font-semibold text-zinc-950">Change password</h3>
                <div class="mt-4 grid gap-3">
                  <input id="currentPassword" class="field" type="password" placeholder="Current password" />
                  <input id="newPassword" class="field" type="password" placeholder="New password" />
                  <button class="btn-primary w-full" type="submit">Change password</button>
                </div>
              </form>
              <form id="recoveryForm" class="rounded-[1.5rem] border border-amber-900/10 bg-white/65 p-4">
                <h3 class="text-lg font-semibold text-zinc-950">Recovery reset</h3>
                <div class="mt-4 grid gap-3">
                  <input id="recoveryEmail" class="field" type="email" placeholder="user@example.com" />
                  <input id="recoveryPassword" class="field" type="password" placeholder="Replacement password" />
                  <button class="btn-primary w-full" type="submit">Reset password</button>
                </div>
              </form>
            </div>
          </article>
        </section>

        <section data-tab-panel="keys" class="dashboard-panel hidden">
          <article class="panel p-5">
            <div class="flex flex-wrap items-start justify-between gap-3">
              <div>
                <h2 class="text-lg font-semibold">Edge API keys</h2>
                <p class="mt-1 text-sm text-zinc-600">Create, review, and revoke keys for edge devices.</p>
              </div>
              <p id="apiKeyCreateStatus" class="text-xs text-zinc-500">Ready.</p>
            </div>
            <form id="apiKeyForm" class="mt-4 grid gap-3 md:grid-cols-[1fr_180px]">
              <input id="apiKeyName" class="field" placeholder="Barn 1 Edge Device" />
              <button class="btn-primary w-full" type="submit">Create key</button>
            </form>
            <div id="apiKeyReveal" class="mt-4 hidden rounded-[1.5rem] border border-emerald-700/20 bg-emerald-50 p-4 text-sm text-emerald-900"></div>
            <div id="apiKeysList" class="mt-4 grid gap-3"></div>
          </article>
        </section>

        <section data-tab-panel="barns" class="dashboard-panel hidden">
          <article class="panel p-5">
            <div class="flex flex-wrap items-start justify-between gap-3">
              <div>
                <h2 class="text-lg font-semibold">Barns</h2>
                <p class="mt-1 text-sm text-zinc-600">Live barn data from the API, including hygiene summaries where available.</p>
              </div>
            </div>
            <div id="barnsList" class="mt-5 grid gap-4 xl:grid-cols-2"></div>
          </article>
        </section>

        <section data-tab-panel="devices" class="dashboard-panel hidden">
          <div class="grid gap-4 xl:grid-cols-[0.9fr_1.1fr]">
            <form id="deviceForm" class="panel p-5">
              <h2 class="text-lg font-semibold">Create or update device</h2>
              <div class="mt-4 grid gap-3 md:grid-cols-2">
                <input id="deviceIdInput" class="field" placeholder="Device ID" />
                <input id="deviceBarnIdInput" class="field" placeholder="Barn ID" />
                <input id="deviceNameInput" class="field" placeholder="Device name" />
                <input id="deviceLocationInput" class="field" placeholder="Location" />
                <select id="deviceStatusInput" class="field md:col-span-2">
                  <option value="offline">offline</option>
                  <option value="online">online</option>
                </select>
              </div>
              <p id="deviceStatusMessage" class="mt-4 text-xs text-zinc-500">Ready.</p>
              <button class="btn-primary mt-4 w-full" type="submit">Save device</button>
            </form>
            <article class="panel p-5">
              <h2 class="text-lg font-semibold">Devices</h2>
              <div id="devicesList" class="mt-4 grid gap-3"></div>
            </article>
          </div>
        </section>

        <section data-tab-panel="cameras" class="dashboard-panel hidden">
          <div class="grid gap-4 xl:grid-cols-[0.95fr_1.05fr]">
            <div class="space-y-4">
              <form id="cameraForm" class="panel p-5">
                <h2 class="text-lg font-semibold">Create or update camera</h2>
                <div class="mt-4 grid gap-3 md:grid-cols-2">
                  <input id="cameraDeviceIdInput" class="field" placeholder="Device ID" />
                  <input id="cameraIdInput" class="field" placeholder="Camera ID" />
                  <input id="cameraBarnIdInput" class="field" placeholder="Barn ID" />
                  <input id="cameraNameInput" class="field" placeholder="Camera name" />
                  <input id="cameraStreamInput" class="field md:col-span-2" placeholder="Stream label" />
                </div>
                <p id="cameraStatusMessage" class="mt-4 text-xs text-zinc-500">Ready.</p>
                <button class="btn-primary mt-4 w-full" type="submit">Save camera</button>
              </form>
              <form id="zoneForm" class="panel p-5">
                <h2 class="text-lg font-semibold">Create zone</h2>
                <div class="mt-4 grid gap-3">
                  <input id="zoneCameraIdInput" class="field" placeholder="Camera ID" />
                  <input id="zoneIdInput" class="field" placeholder="Zone ID" />
                  <input id="zoneBarnIdInput" class="field" placeholder="Barn ID" />
                  <input id="zoneDeviceIdInput" class="field" placeholder="Device ID" />
                  <input id="zoneLabelInput" class="field" placeholder="Label" />
                  <textarea id="zonePolygonInput" class="field min-h-28" placeholder='[{"x":0.1,"y":0.1},{"x":0.8,"y":0.1},{"x":0.8,"y":0.8}]'></textarea>
                </div>
                <p id="zoneStatusMessage" class="mt-4 text-xs text-zinc-500">Ready.</p>
                <button class="btn-primary mt-4 w-full" type="submit">Save zone</button>
              </form>
            </div>
            <div class="space-y-4">
              <article class="panel p-5">
                <h2 class="text-lg font-semibold">Cameras</h2>
                <div id="camerasList" class="mt-4 grid gap-3"></div>
              </article>
              <article class="panel p-5">
                <h2 class="text-lg font-semibold">Zones</h2>
                <div id="zonesList" class="mt-4 grid gap-3"></div>
              </article>
            </div>
          </div>
        </section>

        <section data-tab-panel="events" class="dashboard-panel hidden space-y-4">
          <article class="panel p-5">
            <div class="flex items-center justify-between gap-3">
              <div>
                <h2 class="text-lg font-semibold">Event calendar</h2>
                <p class="mt-1 text-sm text-zinc-600">Recent detections grouped by day.</p>
              </div>
              <div class="flex items-center gap-2">
                <button id="calendarPrev" type="button" class="btn-secondary px-3">←</button>
                <p id="calendarLabel" class="min-w-32 text-center text-sm font-semibold text-zinc-950">—</p>
                <button id="calendarNext" type="button" class="btn-secondary px-3">→</button>
              </div>
            </div>
            <div class="mt-4 overflow-x-auto">
              <div class="min-w-[620px]">
                <div class="grid grid-cols-7 gap-2 text-center text-xs font-semibold uppercase tracking-[0.18em] text-zinc-500">
                  <span>Mon</span>
                  <span>Tue</span>
                  <span>Wed</span>
                  <span>Thu</span>
                  <span>Fri</span>
                  <span>Sat</span>
                  <span>Sun</span>
                </div>
                <div id="calendarGrid" class="mt-3 grid grid-cols-7 gap-2"></div>
              </div>
            </div>
            <div class="mt-5 rounded-[1.5rem] border border-amber-900/10 bg-white/60 p-4">
              <div class="flex items-center justify-between gap-3">
                <h3 class="text-sm font-semibold text-zinc-950">Selected day</h3>
                <p id="calendarSelectedDate" class="text-xs text-zinc-500">—</p>
              </div>
              <div id="calendarEventList" class="mt-3 grid gap-3"></div>
            </div>
          </article>

          <article class="panel p-5">
            <div class="flex flex-wrap items-center justify-between gap-3">
              <div>
                <h2 class="text-lg font-semibold"><%= t("dashboard.detectionEvents") %></h2>
                <p class="mt-1 text-sm text-zinc-600"><%= t("dashboard.snapshotsHint") %></p>
              </div>
            </div>
            <div id="eventsList" class="mt-4 grid gap-4 sm:grid-cols-2 2xl:grid-cols-3"></div>
          </article>
        </section>

        <% if (role === "admins") { %>
        <section data-tab-panel="admin" class="dashboard-panel hidden space-y-4">
          <section class="grid gap-4 md:grid-cols-4">
            <article class="panel p-5">
              <p class="text-xs uppercase tracking-[0.22em] text-zinc-500">Admins</p>
              <p id="adminAdminsCount" class="mt-3 text-3xl font-bold">0</p>
            </article>
            <article class="panel p-5">
              <p class="text-xs uppercase tracking-[0.22em] text-zinc-500">Farmers</p>
              <p id="adminFarmersCount" class="mt-3 text-3xl font-bold">0</p>
            </article>
            <article class="panel p-5">
              <p class="text-xs uppercase tracking-[0.22em] text-zinc-500">Staff</p>
              <p id="adminStaffCount" class="mt-3 text-3xl font-bold">0</p>
            </article>
            <article class="panel p-5">
              <p class="text-xs uppercase tracking-[0.22em] text-zinc-500">Total events</p>
              <p id="adminEventsCount" class="mt-3 text-3xl font-bold">0</p>
            </article>
          </section>
          <div class="grid gap-4 xl:grid-cols-[0.88fr_1.12fr]">
            <form id="coworkerForm" class="panel p-5">
              <h2 class="text-lg font-semibold">Add coworker</h2>
              <p class="mt-1 text-sm text-zinc-600">Create farmers and staff accounts for the same BarnSight account workspace.</p>
              <div class="mt-4 grid gap-3 md:grid-cols-2">
                <select id="coworkerRole" class="field md:col-span-2">
                  <option value="farmers">farmer</option>
                  <option value="staff">staff</option>
                </select>
                <input id="coworkerFirstName" class="field" placeholder="First name" />
                <input id="coworkerMiddleName" class="field" placeholder="Middle name" />
                <input id="coworkerLastName" class="field" placeholder="Last name" />
                <input id="coworkerUsername" class="field" placeholder="Username" />
                <input id="coworkerEmail" class="field md:col-span-2" type="email" placeholder="Email" />
                <input id="coworkerPassword" class="field md:col-span-2" type="password" placeholder="Password" />
              </div>
              <p id="coworkerStatus" class="mt-4 text-xs text-zinc-500">Ready.</p>
              <button class="btn-primary mt-4 w-full" type="submit">Create coworker</button>
            </form>
            <article class="panel p-5">
              <div class="flex flex-wrap items-center justify-between gap-3">
                <h2 class="text-lg font-semibold">Coworkers</h2>
                <div class="flex gap-2">
                  <button type="button" class="admin-role-filter btn-secondary px-3" data-role="admins">Admins</button>
                  <button type="button" class="admin-role-filter btn-secondary px-3" data-role="farmers">Farmers</button>
                  <button type="button" class="admin-role-filter btn-secondary px-3" data-role="staff">Staff</button>
                </div>
              </div>
              <div id="coworkersList" class="mt-4 grid gap-3"></div>
            </article>
          </div>
        </section>
        <% } %>

        <section data-tab-panel="system" class="dashboard-panel hidden">
          <div class="grid gap-4 xl:grid-cols-[0.75fr_1.25fr]">
            <article class="panel p-5">
              <h2 class="text-lg font-semibold">System</h2>
              <div class="mt-4 grid gap-3">
                <div class="rounded-[1.5rem] border border-amber-900/10 bg-white/65 p-4">
                  <p class="text-xs uppercase tracking-[0.18em] text-zinc-500">Health</p>
                  <p id="systemHealth" class="mt-2 text-lg font-semibold text-zinc-950">Checking…</p>
                </div>
                <div class="rounded-[1.5rem] border border-amber-900/10 bg-white/65 p-4">
                  <p class="text-xs uppercase tracking-[0.18em] text-zinc-500">Role</p>
                  <p class="mt-2 text-lg font-semibold text-zinc-950"><%= role %></p>
                </div>
              </div>
            </article>
            <article class="panel p-5">
              <h2 class="text-lg font-semibold">Metrics</h2>
              <pre id="metricsOutput" class="mt-4 max-h-[28rem] overflow-auto rounded-2xl border border-amber-900/15 bg-zinc-950/92 p-3 text-xs text-amber-50"></pre>
            </article>
          </div>
        </section>
      </section>
    </main>

    <script>
      window.BARNSIGHT_ROLE = "<%= role %>";
      window.APP_LOCALE = "<%= locale %>";
    </script>
    <script src="/public/pageTransitions.js"></script>
    <script src="/public/dashboard.js"></script>
  </body>
</html>
