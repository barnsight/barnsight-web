<!doctype html>
<html lang="<%= locale %>">
  <head>
    <%- include("partials/head") %>
    <title><%= t("dashboard.title") %></title>
  </head>
  <body class="dashboard-page page-transition font-sans">
    <main class="mx-auto max-w-[1780px] px-4 py-4 sm:px-6 lg:px-8">
      <div class="grid gap-4 xl:grid-cols-[280px_1fr]">
        <aside class="panel p-5 sm:p-6 xl:sticky xl:top-4 xl:self-start">
          <div class="flex items-start gap-3">
            <img class="brand-logo" src="/assets/brand/logo-t.png" alt="BarnSight logo" />
            <div class="min-w-0">
              <p class="text-sm uppercase tracking-[0.24em] text-ink-mute">BarnSight</p>
              <h1 class="mt-2 font-display text-3xl font-extrabold tracking-tight text-ink">
                <%= t("nav.dashboard") %>
              </h1>
              <p class="mt-2 text-sm leading-7 text-ink-soft">
                <%= locale === "uk"
                  ? "Панель моніторингу гігієни, edge-пристроїв і сценаріїв перегляду."
                  : "Operations dashboard for hygiene monitoring, edge devices, and review workflows." %>
              </p>
            </div>
          </div>

          <div class="mt-5 rounded-[12px_22px_14px_24px] border border-edge/45 bg-paper-warm/65 p-4">
            <div class="flex items-center justify-between gap-3">
              <div>
                <p class="text-xs uppercase tracking-[0.18em] text-ink-mute"><%= locale === "uk" ? "Сесія" : "Session" %></p>
                <p class="mt-2 text-sm font-semibold text-ink"><%= role %></p>
              </div>
              <span class="inline-flex items-center gap-2 rounded-[10px_18px_12px_20px] border border-edge/45 bg-paper-warm px-3 py-1 text-xs font-semibold text-ink-mute">
                <span class="status-dot" data-api-health></span>
                <span data-api-health-label><%= locale === "uk" ? "API · перевірка…" : "API · checking…" %></span>
              </span>
            </div>
          </div>

          <nav class="mt-5 space-y-2" id="dashboardTabs" aria-label="<%= locale === 'uk' ? 'Навігація панелі' : 'Dashboard navigation' %>">
            <button type="button" class="dashboard-tab w-full text-left" data-tab="overview"><%= locale === "uk" ? "Огляд" : "Overview" %></button>
            <button type="button" class="dashboard-tab w-full text-left" data-tab="profile"><%= locale === "uk" ? "Профіль" : "Profile" %></button>
            <button type="button" class="dashboard-tab w-full text-left" data-tab="keys"><%= locale === "uk" ? "API-ключі" : "API Keys" %></button>
            <button type="button" class="dashboard-tab w-full text-left" data-tab="events"><%= locale === "uk" ? "Події" : "Events" %></button>
            <% if (role === "admins") { %>
            <button type="button" class="dashboard-tab w-full text-left" data-tab="admin"><%= locale === "uk" ? "Адмін" : "Admin" %></button>
            <% } %>
            <button type="button" class="dashboard-tab w-full text-left" data-tab="system"><%= locale === "uk" ? "Система" : "System" %></button>
          </nav>

          <div class="mt-5 grid gap-3">
            <a href="/" class="btn-secondary w-full"><%= t("nav.backHome") %></a>
            <button id="refreshBtn" class="btn-primary w-full"><%= t("dashboard.refresh") %></button>
            <form action="/logout" method="post">
              <button class="btn-secondary w-full" type="submit"><%= t("nav.logout") %></button>
            </form>
          </div>
        </aside>

        <section class="space-y-4">
          <header class="panel p-5 sm:p-6">
            <div class="flex flex-wrap items-start justify-between gap-4">
              <div>
                <p class="text-sm uppercase tracking-[0.24em] text-ink-mute">BarnSight</p>
                <h2 class="mt-2 font-display text-3xl font-extrabold tracking-tight text-ink sm:text-5xl">
                  <%= locale === "uk" ? "Операційний огляд" : "Operational overview" %>
                </h2>
                <p class="mt-2 max-w-3xl text-sm leading-7 text-ink-soft">
                  <%= locale === "uk"
                    ? "Єдина робоча поверхня для обладнання, подій і системного стану BarnSight."
                    : "Single operating surface for equipment, event review, and BarnSight system health." %>
                </p>
              </div>
              <div class="flex flex-wrap items-center gap-3">
                <%- include("partials/language-switcher") %>
                <%- include("partials/theme-toggle") %>
              </div>
            </div>
            <div class="mt-6 grid gap-3 lg:grid-cols-[1fr_auto]">
              <div class="rounded-[12px_22px_14px_24px] border border-edge/45 bg-paper-warm/65 p-4">
                <p class="text-xs uppercase tracking-[0.18em] text-ink-mute"><%= locale === "uk" ? "Робочий контур" : "Workspace" %></p>
                <p class="mt-2 text-sm text-ink-soft">
                  <%= locale === "uk"
                    ? "Edge-пристрої -> API -> зберігання -> панель перегляду."
                    : "Edge devices -> API -> storage -> review dashboard." %>
                </p>
              </div>
              <div class="rounded-[12px_22px_14px_24px] border border-edge/45 bg-paper-warm/65 p-4">
                <p class="text-xs uppercase tracking-[0.18em] text-ink-mute"><%= locale === "uk" ? "Оновлення" : "Refresh" %></p>
                <p id="lastRefreshLabel" class="mt-2 text-sm text-ink-soft"><%= locale === "uk" ? "Щойно відкрито" : "Just opened" %></p>
              </div>
            </div>
          </header>

          <section class="space-y-4">
        <section data-tab-panel="overview" class="dashboard-panel space-y-4">
          <section class="grid gap-4 md:grid-cols-2 2xl:grid-cols-4">
            <article class="panel p-5">
              <p class="text-sm text-ink-mute"><%= t("dashboard.user") %></p>
              <h2 id="meName" class="mt-3 font-display text-2xl font-bold">...</h2>
              <p id="meUsername" class="mt-1 text-sm text-ink-soft">—</p>
            </article>
            <article class="panel p-5">
              <p class="text-sm text-ink-mute"><%= locale === "uk" ? "Сесії" : "Sessions" %></p>
              <h2 id="sessionCountValue" class="mt-3 font-display text-2xl font-bold">0</h2>
              <p id="sessionCountLabel" class="mt-1 text-sm text-ink-soft"><%= locale === "uk" ? "Активні: —" : "Active: —" %></p>
            </article>
            <article class="panel p-5">
              <p class="text-sm text-ink-mute"><%= t("dashboard.events") %></p>
              <h2 id="eventCount" class="mt-3 font-display text-2xl font-bold">0</h2>
              <p id="calendarSummary" class="mt-1 text-sm text-ink-soft"><%= locale === "uk" ? "Календар завантажується…" : "Calendar loading…" %></p>
            </article>
            <article class="panel p-5">
              <p class="text-sm text-ink-mute"><%= locale === "uk" ? "API-ключі" : "API keys" %></p>
              <h2 id="apiKeyCountValue" class="mt-3 font-display text-2xl font-bold">0</h2>
              <p id="apiKeyCountLabel" class="mt-1 text-sm text-ink-soft"><%= locale === "uk" ? "Останнє використання: —" : "Last used: —" %></p>
            </article>
          </section>

          <section class="grid gap-4 xl:grid-cols-[1.1fr_0.9fr]">
            <article class="panel p-5">
              <div class="flex items-start justify-between gap-3">
                <div>
                  <h2 class="font-display text-lg font-semibold"><%= locale === "uk" ? "Швидкі дії" : "Quick actions" %></h2>
                  <p class="mt-1 text-sm text-ink-soft"><%= locale === "uk" ? "Переходи до найчастіших операцій BarnSight." : "Shortcuts to the most common BarnSight workflows." %></p>
                </div>
              </div>
              <div id="quickActions" class="mt-4 grid gap-3 sm:grid-cols-2"></div>
            </article>
            <article class="panel p-5">
              <div class="flex items-start justify-between gap-3">
                <div>
                  <h2 class="font-display text-lg font-semibold"><%= locale === "uk" ? "Чекліст запуску" : "Setup checklist" %></h2>
                  <p class="mt-1 text-sm text-ink-soft"><%= locale === "uk" ? "Підказки для першого налаштування, якщо даних ще мало." : "Onboarding guidance when the workspace is still being set up." %></p>
                </div>
              </div>
              <div id="setupChecklist" class="mt-4 grid gap-3"></div>
            </article>
          </section>
        </section>

        <section data-tab-panel="profile" class="dashboard-panel hidden">
          <article class="panel p-5">
            <div class="flex flex-wrap items-start justify-between gap-3">
              <div>
                <h2 class="font-display text-lg font-semibold"><%= locale === "uk" ? "Профіль" : "Profile" %></h2>
                <p class="mt-1 text-sm text-ink-soft"><%= locale === "uk" ? "Дані користувача, email і керування паролем." : "User info, email, and password controls." %></p>
              </div>
              <p id="profileStatus" class="text-xs text-ink-mute"><%= locale === "uk" ? "Профіль готовий." : "Profile ready." %></p>
            </div>
            <div id="profileSummary" class="mt-4 grid gap-3 md:grid-cols-2"></div>
            <div class="mt-5 grid gap-4 2xl:grid-cols-2">
              <form id="profileForm" class="rounded-[1.2rem_1.8rem_1.4rem_2rem] border border-edge/45 bg-paper-warm/65 p-4">
                <h3 class="font-display text-lg font-semibold text-ink"><%= locale === "uk" ? "Оновити профіль" : "Update profile" %></h3>
                <div class="mt-4 grid gap-3">
                  <input id="profileFirstName" class="field" placeholder="<%= locale === 'uk' ? 'Імʼя' : 'First name' %>" />
                  <input id="profileMiddleName" class="field" placeholder="<%= locale === 'uk' ? 'По батькові' : 'Middle name' %>" />
                  <input id="profileLastName" class="field" placeholder="<%= locale === 'uk' ? 'Прізвище' : 'Last name' %>" />
                  <button class="btn-primary w-full" type="submit"><%= locale === "uk" ? "Зберегти профіль" : "Save profile" %></button>
                </div>
              </form>
              <form id="emailForm" class="rounded-[1.2rem_1.8rem_1.4rem_2rem] border border-edge/45 bg-paper-warm/65 p-4">
                <h3 class="font-display text-lg font-semibold text-ink"><%= locale === "uk" ? "Оновити email" : "Update email" %></h3>
                <div class="mt-4 grid gap-3">
                  <input id="profileEmail" class="field" type="email" placeholder="user@example.com" />
                  <input id="emailPassword" class="field" type="password" placeholder="<%= locale === 'uk' ? 'Поточний пароль' : 'Current password' %>" />
                  <button class="btn-primary w-full" type="submit"><%= locale === "uk" ? "Зберегти email" : "Save email" %></button>
                </div>
              </form>
              <form id="passwordForm" class="rounded-[1.2rem_1.8rem_1.4rem_2rem] border border-edge/45 bg-paper-warm/65 p-4">
                <h3 class="font-display text-lg font-semibold text-ink"><%= locale === "uk" ? "Змінити пароль" : "Change password" %></h3>
                <div class="mt-4 grid gap-3">
                  <input id="currentPassword" class="field" type="password" placeholder="<%= locale === 'uk' ? 'Поточний пароль' : 'Current password' %>" />
                  <input id="newPassword" class="field" type="password" placeholder="<%= locale === 'uk' ? 'Новий пароль' : 'New password' %>" />
                  <button class="btn-primary w-full" type="submit"><%= locale === "uk" ? "Змінити пароль" : "Change password" %></button>
                </div>
              </form>
              <form id="recoveryForm" class="rounded-[1.2rem_1.8rem_1.4rem_2rem] border border-edge/45 bg-paper-warm/65 p-4">
                <h3 class="font-display text-lg font-semibold text-ink"><%= locale === "uk" ? "Скидання через відновлення" : "Recovery reset" %></h3>
                <div class="mt-4 grid gap-3">
                  <input id="recoveryEmail" class="field" type="email" placeholder="user@example.com" />
                  <input id="recoveryPassword" class="field" type="password" placeholder="<%= locale === 'uk' ? 'Новий пароль для заміни' : 'Replacement password' %>" />
                  <button class="btn-primary w-full" type="submit"><%= locale === "uk" ? "Скинути пароль" : "Reset password" %></button>
                </div>
              </form>
            </div>
            <div class="mt-5 rounded-[1.2rem_1.8rem_1.4rem_2rem] border border-edge/45 bg-paper-warm/65 p-4">
              <div class="flex flex-wrap items-start justify-between gap-3">
                <div>
                  <h3 class="font-display text-lg font-semibold text-ink"><%= locale === "uk" ? "Активні сесії" : "Active sessions" %></h3>
                  <p class="mt-1 text-sm text-ink-soft"><%= locale === "uk" ? "Поточні токенізовані сесії з `/api/v1/user/me/sessions`." : "Current tokenized sessions from `/api/v1/user/me/sessions`." %></p>
                </div>
                <button id="refreshSessionsBtn" type="button" class="btn-secondary"><%= locale === "uk" ? "Оновити сесії" : "Refresh sessions" %></button>
              </div>
              <div id="sessionsList" class="mt-4 grid gap-3"></div>
            </div>
          </article>
        </section>

        <section data-tab-panel="keys" class="dashboard-panel hidden">
          <article class="panel p-5">
            <div class="flex flex-wrap items-start justify-between gap-3">
              <div>
                <h2 class="font-display text-lg font-semibold"><%= locale === "uk" ? "Edge API-ключі" : "Edge API keys" %></h2>
                <p class="mt-1 text-sm text-ink-soft"><%= locale === "uk" ? "Створюйте, переглядайте та відкликайте ключі для edge-пристроїв." : "Create, review, and revoke keys for edge devices." %></p>
              </div>
              <p id="apiKeyCreateStatus" class="text-xs text-ink-mute"><%= locale === "uk" ? "Готово." : "Ready." %></p>
            </div>
            <div class="notice mt-4">
              <p class="font-semibold text-ink"><%= locale === "uk" ? "Як працює edge API-ключ" : "How an edge API key works" %></p>
              <p class="mt-1 text-sm text-ink-soft">
                <%= locale === "uk"
                  ? "Ключ встановлюється на edge-пристрої. Події, детекції та знімки, надіслані цим ключем, привʼязуються до правильного акаунта BarnSight, господарства та обладнання. Повне значення ключа показується лише один раз."
                  : "The key is installed on an edge device. Events, detections, and snapshots sent with that key are associated with the correct BarnSight account, barn, and equipment. The full secret is shown only once." %>
              </p>
            </div>
            <div class="mt-4 flex flex-wrap gap-3">
              <button id="listApiKeysBtn" type="button" class="btn-secondary">
                <%= locale === "uk" ? "List API Keys" : "List API Keys" %>
              </button>
              <button id="createApiKeyBtn" type="button" class="btn-primary">
                <%= locale === "uk" ? "Create an API Key" : "Create an API Key" %>
              </button>
            </div>
            <div class="mt-3 rounded-[12px_22px_14px_24px] border border-edge/45 bg-paper-warm/65 px-4 py-3 text-xs text-ink-mute">
              <p><span class="font-semibold text-ink">GET</span> <code>/api/v1/api-keys</code> - <%= locale === "uk" ? "List API Keys" : "List API Keys" %></p>
              <p class="mt-1"><span class="font-semibold text-ink">POST</span> <code>/api/v1/api-keys</code> - <%= locale === "uk" ? "Create an API Key" : "Create an API Key" %></p>
            </div>
            <form id="apiKeyForm" class="mt-4 grid gap-3 md:grid-cols-2">
              <input id="apiKeyName" class="field" placeholder="<%= locale === 'uk' ? 'Edge-пристрій господарства 1' : 'Barn 1 Edge Device' %>" />
              <input id="apiKeyDeviceId" class="field" placeholder="<%= locale === 'uk' ? 'ID пристрою (optional)' : 'Device ID (optional)' %>" />
              <input id="apiKeyBarnId" class="field" placeholder="<%= locale === 'uk' ? 'ID господарства (optional)' : 'Barn ID (optional)' %>" />
              <input id="apiKeyExpiresDays" class="field" type="number" min="1" placeholder="<%= locale === 'uk' ? 'Термін дії, днів' : 'Expires in days' %>" />
              <input id="apiKeyScopes" class="field md:col-span-2" placeholder="<%= locale === 'uk' ? 'Scopes через кому, напр. events:write,snapshots:write' : 'Comma-separated scopes, e.g. events:write,snapshots:write' %>" />
              <button class="btn-primary md:col-span-2 w-full" type="submit"><%= locale === "uk" ? "Створити ключ" : "Create key" %></button>
            </form>
            <div id="apiKeyReveal" class="mt-4 hidden notice"></div>
            <div id="apiKeysError" class="mt-4 hidden notice is-bad"></div>
            <div id="apiKeysList" class="mt-4 grid gap-3"></div>
          </article>
        </section>

        <section data-tab-panel="events" class="dashboard-panel hidden space-y-4">
          <article class="panel p-5">
            <div class="flex items-center justify-between gap-3">
              <div>
                <h2 class="font-display text-lg font-semibold"><%= locale === "uk" ? "Календар подій" : "Event calendar" %></h2>
                <p class="mt-1 text-sm text-ink-soft"><%= locale === "uk" ? "Останні детекції, згруповані за днями." : "Recent detections grouped by day." %></p>
              </div>
              <div class="flex items-center gap-2">
                <button id="calendarPrev" type="button" class="btn-secondary px-3">←</button>
                <p id="calendarLabel" class="min-w-32 text-center text-sm font-semibold text-ink">—</p>
                <button id="calendarNext" type="button" class="btn-secondary px-3">→</button>
              </div>
            </div>
            <div class="mt-4 overflow-x-auto">
              <div class="min-w-[620px]">
                <div class="grid grid-cols-7 gap-2 text-center text-xs font-semibold uppercase tracking-[0.18em] text-ink-mute">
                  <% if (locale === "uk") { %>
                  <span>Пн</span><span>Вт</span><span>Ср</span><span>Чт</span><span>Пт</span><span>Сб</span><span>Нд</span>
                  <% } else { %>
                  <span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span><span>Sun</span>
                  <% } %>
                </div>
                <div id="calendarGrid" class="mt-3 grid grid-cols-7 gap-2"></div>
              </div>
            </div>
            <div class="mt-5 rounded-[1.2rem_1.8rem_1.4rem_2rem] border border-edge/45 bg-paper-warm/65 p-4">
              <div class="flex items-center justify-between gap-3">
                <h3 class="text-sm font-semibold text-ink"><%= locale === "uk" ? "Обраний день" : "Selected day" %></h3>
                <p id="calendarSelectedDate" class="text-xs text-ink-mute">—</p>
              </div>
              <div id="calendarEventList" class="mt-3 grid gap-3"></div>
            </div>
          </article>

          <article class="panel p-5">
            <div class="flex flex-wrap items-center justify-between gap-3">
              <div>
                <h2 class="font-display text-lg font-semibold"><%= t("dashboard.detectionEvents") %></h2>
                <p class="mt-1 text-sm text-ink-soft"><%= t("dashboard.snapshotsHint") %></p>
              </div>
            </div>
            <div id="eventsNotice" class="hidden"></div>
            <div id="eventActionStatus" class="mt-3 text-xs text-ink-mute"><%= locale === "uk" ? "Дії з подіями готові." : "Event actions ready." %></div>
            <div id="eventsList" class="mt-4 grid gap-4 sm:grid-cols-2 2xl:grid-cols-3"></div>
          </article>
        </section>

        <% if (role === "admins") { %>
        <section data-tab-panel="admin" class="dashboard-panel hidden space-y-4">
          <section class="grid gap-4 md:grid-cols-4">
            <article class="panel p-5">
              <p class="text-xs uppercase tracking-[0.22em] text-ink-mute"><%= locale === "uk" ? "Адміни" : "Admins" %></p>
              <p id="adminAdminsCount" class="mt-3 font-display text-3xl font-bold">0</p>
            </article>
            <article class="panel p-5">
              <p class="text-xs uppercase tracking-[0.22em] text-ink-mute"><%= locale === "uk" ? "Фермери" : "Farmers" %></p>
              <p id="adminFarmersCount" class="mt-3 font-display text-3xl font-bold">0</p>
            </article>
            <article class="panel p-5">
              <p class="text-xs uppercase tracking-[0.22em] text-ink-mute"><%= locale === "uk" ? "Персонал" : "Staff" %></p>
              <p id="adminStaffCount" class="mt-3 font-display text-3xl font-bold">0</p>
            </article>
            <article class="panel p-5">
              <p class="text-xs uppercase tracking-[0.22em] text-ink-mute"><%= locale === "uk" ? "Усього подій" : "Total events" %></p>
              <p id="adminEventsCount" class="mt-3 font-display text-3xl font-bold">0</p>
            </article>
          </section>
          <div class="grid gap-4 xl:grid-cols-[0.88fr_1.12fr]">
            <form id="coworkerForm" class="panel p-5">
              <h2 class="font-display text-lg font-semibold"><%= locale === "uk" ? "Додати колегу" : "Add coworker" %></h2>
              <p class="mt-1 text-sm text-ink-soft"><%= locale === "uk" ? "Створюйте акаунти фермерів і персоналу в межах того самого робочого простору BarnSight." : "Create farmers and staff accounts for the same BarnSight account workspace." %></p>
              <div class="mt-4 grid gap-3 md:grid-cols-2">
                <select id="coworkerRole" class="field md:col-span-2">
                  <option value="farmers"><%= locale === "uk" ? "фермер" : "farmer" %></option>
                  <option value="staff"><%= locale === "uk" ? "персонал" : "staff" %></option>
                </select>
                <input id="coworkerFirstName" class="field" placeholder="<%= locale === 'uk' ? 'Імʼя' : 'First name' %>" />
                <input id="coworkerMiddleName" class="field" placeholder="<%= locale === 'uk' ? 'По батькові' : 'Middle name' %>" />
                <input id="coworkerLastName" class="field" placeholder="<%= locale === 'uk' ? 'Прізвище' : 'Last name' %>" />
                <input id="coworkerUsername" class="field" placeholder="<%= locale === 'uk' ? 'Логін' : 'Username' %>" />
                <input id="coworkerEmail" class="field md:col-span-2" type="email" placeholder="Email" />
                <input id="coworkerPassword" class="field md:col-span-2" type="password" placeholder="<%= locale === 'uk' ? 'Пароль' : 'Password' %>" />
              </div>
              <p id="coworkerStatus" class="mt-4 text-xs text-ink-mute"><%= locale === "uk" ? "Готово." : "Ready." %></p>
              <button class="btn-primary mt-4 w-full" type="submit"><%= locale === "uk" ? "Створити колегу" : "Create coworker" %></button>
            </form>
            <article class="panel p-5">
              <div class="flex flex-wrap items-center justify-between gap-3">
                <h2 class="font-display text-lg font-semibold"><%= locale === "uk" ? "Колеги" : "Coworkers" %></h2>
                <div class="flex gap-2">
                  <button type="button" class="admin-role-filter btn-secondary px-3" data-role="admins"><%= locale === "uk" ? "Адміни" : "Admins" %></button>
                  <button type="button" class="admin-role-filter btn-secondary px-3" data-role="farmers"><%= locale === "uk" ? "Фермери" : "Farmers" %></button>
                  <button type="button" class="admin-role-filter btn-secondary px-3" data-role="staff"><%= locale === "uk" ? "Персонал" : "Staff" %></button>
                </div>
              </div>
              <div id="coworkersList" class="mt-4 grid gap-3"></div>
            </article>
          </div>
          <article class="panel p-5">
            <div class="flex flex-wrap items-start justify-between gap-3">
              <div>
                <h2 class="font-display text-lg font-semibold"><%= locale === "uk" ? "Audit logs" : "Audit logs" %></h2>
                <p class="mt-1 text-sm text-ink-soft"><%= locale === "uk" ? "Дані з `/api/v1/admin/audit-logs`." : "Data from `/api/v1/admin/audit-logs`." %></p>
              </div>
              <button id="refreshAuditLogsBtn" type="button" class="btn-secondary"><%= locale === "uk" ? "Оновити логи" : "Refresh logs" %></button>
            </div>
            <div id="auditLogsList" class="mt-4 grid gap-3"></div>
          </article>
        </section>
        <% } %>

        <section data-tab-panel="system" class="dashboard-panel hidden">
          <div class="grid gap-4 xl:grid-cols-[0.75fr_1.25fr]">
            <article class="panel p-5">
              <h2 class="font-display text-lg font-semibold"><%= locale === "uk" ? "Система" : "System" %></h2>
              <div class="mt-4 grid gap-3">
                <div class="rounded-[1.2rem_1.8rem_1.4rem_2rem] border border-edge/45 bg-paper-warm/65 p-4">
                  <p class="text-xs uppercase tracking-[0.18em] text-ink-mute"><%= locale === "uk" ? "Стан" : "Health" %></p>
                  <p id="systemHealth" class="mt-2 font-display text-lg font-semibold text-ink"><%= locale === "uk" ? "Перевірка…" : "Checking…" %></p>
                </div>
                <div class="rounded-[1.2rem_1.8rem_1.4rem_2rem] border border-edge/45 bg-paper-warm/65 p-4">
                  <p class="text-xs uppercase tracking-[0.18em] text-ink-mute"><%= locale === "uk" ? "Роль" : "Role" %></p>
                  <p class="mt-2 font-display text-lg font-semibold text-ink"><%= role %></p>
                </div>
                <div id="systemCards" class="grid gap-3"></div>
              </div>
            </article>
            <article class="panel p-5">
              <h2 class="font-display text-lg font-semibold"><%= locale === "uk" ? "Метрики" : "Metrics" %></h2>
              <pre id="metricsOutput" class="mt-4 max-h-[28rem] overflow-auto rounded-[1.2rem_1.8rem_1.4rem_2rem] border border-edge/45 bg-ink/95 p-3 font-mono text-xs text-paper"></pre>
            </article>
          </div>
        </section>
          </section>
        </section>
      </div>
    </main>

    <dialog id="confirmDialog" class="confirm-dialog">
      <form method="dialog" class="panel p-5 sm:p-6">
        <p id="confirmDialogTitle" class="font-display text-2xl font-bold text-ink"><%= locale === "uk" ? "Підтвердження" : "Confirm action" %></p>
        <p id="confirmDialogMessage" class="mt-3 text-sm leading-7 text-ink-soft"></p>
        <div class="mt-5 flex flex-wrap justify-end gap-3">
          <button id="confirmDialogCancel" class="btn-secondary" value="cancel"><%= locale === "uk" ? "Скасувати" : "Cancel" %></button>
          <button id="confirmDialogAccept" class="btn-primary" value="confirm"><%= locale === "uk" ? "Підтвердити" : "Confirm" %></button>
        </div>
      </form>
    </dialog>

    <dialog id="imagePreviewModal" class="image-preview-dialog">
      <div class="panel p-4 sm:p-5">
        <div class="flex items-start justify-between gap-3">
          <div>
            <p id="imagePreviewTitle" class="font-display text-xl font-semibold text-ink"><%= locale === "uk" ? "Знімок події" : "Event snapshot" %></p>
            <p id="imagePreviewMeta" class="mt-1 text-xs text-ink-mute">—</p>
          </div>
          <button id="imagePreviewClose" type="button" class="btn-secondary px-3"><%= locale === "uk" ? "Закрити" : "Close" %></button>
        </div>
        <img id="imagePreviewImage" class="mt-4 max-h-[75vh] w-full rounded-[12px_22px_14px_24px] border border-edge/45 object-contain bg-paper-soft" alt="" />
      </div>
    </dialog>

    <div id="toastStack" class="toast-stack" aria-live="polite" aria-atomic="true"></div>

    <script>
      window.BARNSIGHT_ROLE = "<%= role %>";
      window.APP_LOCALE = "<%= locale %>";
    </script>
    <script src="/public/pageTransitions.js"></script>
    <script src="/public/site.js"></script>
    <script src="/public/dashboard.js"></script>
  </body>
</html>
