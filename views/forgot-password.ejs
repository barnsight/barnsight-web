<!doctype html>
<html lang="<%= locale %>">
  <head>
    <%- include("partials/head") %>
    <title><%= locale === "uk" ? "Відновлення доступу - BarnSight" : "Recover access - BarnSight" %></title>
  </head>
  <body class="page-transition font-sans">
    <main class="mx-auto flex min-h-screen max-w-6xl items-center px-6 py-12">
      <section class="panel mx-auto grid max-w-4xl gap-6 overflow-hidden p-0 lg:grid-cols-[1.05fr_0.95fr]">
        <div class="relative min-h-[320px] overflow-hidden bg-paper-soft">
          <img src="/assets/brand/background.png" alt="" class="h-full w-full object-cover" />
          <div class="absolute inset-0 bg-ink/35"></div>
          <div class="absolute inset-x-0 bottom-0 p-6 text-paper">
            <p class="text-xs uppercase tracking-[0.24em] text-paper/75">BarnSight</p>
            <h1 class="mt-2 font-display text-3xl font-bold">
              <%= locale === "uk" ? "Відновлення доступу" : "Recover account access" %>
            </h1>
          </div>
        </div>
        <div class="p-8">
          <div class="flex items-center justify-between gap-3">
            <a href="/login" class="text-sm text-ink-soft hover:text-ochre-deep"><%= locale === "uk" ? "← До входу" : "← Back to login" %></a>
            <div class="flex items-center gap-2">
              <%- include("partials/language-switcher") %>
              <%- include("partials/theme-toggle") %>
            </div>
          </div>
          <p class="mt-6 text-sm leading-7 text-ink-soft">
            <%= locale === "uk"
              ? "Поточний API не надає окремого endpoint для email-відновлення. Використовуйте зміну пароля в профілі після входу або зверніться до адміністратора для ініціації скидання."
              : "The current API does not expose a dedicated email recovery endpoint. Use the profile password change flow after login or contact an administrator to initiate a reset." %>
          </p>
          <div class="notice mt-5">
            <p class="font-semibold text-ink"><%= locale === "uk" ? "Доступний зараз сценарій" : "Available workflow today" %></p>
            <p class="mt-1 text-sm text-ink-soft">
              <%= locale === "uk"
                ? "Після входу перейдіть у Profile -> Recovery reset. Сторінка введена як орієнтир і місце для майбутнього backend flow."
                : "After login, go to Profile -> Recovery reset. This page is a guided placeholder for a future backend recovery flow." %>
            </p>
          </div>
          <div class="mt-6 flex flex-wrap gap-3">
            <a href="/login" class="btn-primary"><%= locale === "uk" ? "Повернутися до входу" : "Return to login" %></a>
            <a href="/reset-password" class="btn-secondary"><%= locale === "uk" ? "Переглянути reset screen" : "View reset screen" %></a>
          </div>
        </div>
      </section>
    </main>
    <script src="/public/pageTransitions.js"></script>
    <script src="/public/site.js"></script>
  </body>
</html>
