<div class="inline-flex rounded-lg border border-amber-900/15 bg-white/60 p-1 text-xs font-semibold">
  <% for (const link of languageLinks) { %>
  <a
    href="<%= link.href %>"
    class="rounded-md px-2 py-1 <%= link.active ? 'bg-amber-500 text-zinc-950' : 'text-zinc-600 hover:text-amber-900' %>"
  ><%= link.label %></a>
  <% } %>
</div>
