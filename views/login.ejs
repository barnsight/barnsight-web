<!doctype html>
<html lang="uk">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Вхід — BarnSight</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/assets/styles.css" />
  </head>
  <body class="page-transition font-sans">
    <main class="mx-auto flex min-h-screen max-w-6xl items-center px-6 py-12">
      <section class="mx-auto w-full max-w-md panel p-8">
        <a href="/" class="text-sm text-zinc-400 hover:text-zinc-200">← На головну</a>
        <h1 class="mt-3 text-3xl font-bold">Вхід у BarnSight</h1>
        <p class="mt-2 text-sm text-zinc-400">Увійдіть, щоб переглядати події, аналітику та звіти.</p>

        <% if (error) { %>
        <pre class="mt-4 whitespace-pre-wrap rounded-lg border border-zinc-700 bg-zinc-900 px-3 py-2 text-sm text-zinc-200"><%= error %></pre>
        <% } %>

        <form class="mt-6 space-y-4" action="/login" method="post" autocomplete="on">
          <div>
            <label class="mb-1 block text-sm text-zinc-300" for="username">Логін</label>
            <input id="username" class="field" name="username" required />
          </div>
          <div>
            <label class="mb-1 block text-sm text-zinc-300" for="password">Пароль</label>
            <input id="password" class="field" type="password" name="password" required />
          </div>
          <button type="submit" class="btn-primary w-full">Увійти</button>
        </form>
      </section>
    </main>
    <script src="/public/pageTransitions.js"></script>
  </body>
</html>
