<!doctype html>
<html lang="<%= locale %>">
  <head>
    <%- include("partials/head") %>
    <title><%= t("login.title") %></title>
  </head>
  <body class="page-transition font-sans">
    <main class="mx-auto flex min-h-screen max-w-6xl items-center px-6 py-12">
      <section class="mx-auto w-full max-w-md panel tilt-n1 p-8">
        <div class="flex items-center justify-between gap-3">
          <a href="/" class="text-sm text-ink-soft hover:text-ochre-deep"><%= t("nav.backHome") %></a>
          <div class="flex items-center gap-2">
            <%- include("partials/language-switcher") %>
            <%- include("partials/theme-toggle") %>
          </div>
        </div>
        <img class="brand-logo mt-5 h-16 w-16 rounded-2xl" src="/assets/brand/logo-t.png" alt="BarnSight logo" />
        <h1 class="mt-3 font-display text-3xl font-bold text-ink">
          <%= t("login.heading") %>
        </h1>
        <p class="mt-2 text-sm text-ink-soft"><%= t("login.lead") %></p>

        <% if (error) { %>
        <pre class="notice is-bad mt-4 whitespace-pre-wrap font-mono text-xs"><%= error %></pre>
        <% } %>

        <form class="mt-6 space-y-4" action="/login" method="post" autocomplete="on">
          <div>
            <label class="mb-1 block text-sm text-ink-soft" for="username"><%= t("login.username") %></label>
            <input id="username" class="field" name="username" required />
          </div>
          <div>
            <label class="mb-1 block text-sm text-ink-soft" for="password"><%= t("login.password") %></label>
            <input id="password" class="field" type="password" name="password" required />
          </div>
          <button type="submit" class="btn-primary w-full"><%= t("login.submit") %></button>
        </form>
        <p class="mt-5 text-center text-sm text-ink-soft">
          <%= t("login.noAccount") %>
          <a href="/register" class="font-semibold text-ochre-deep hover:text-ochre"><%= t("login.register") %></a>
        </p>
        <p class="mt-2 text-center text-sm text-ink-soft">
          <a href="/pricing" class="font-semibold text-ochre-deep hover:text-ochre"><%= t("nav.pricing") %></a>
        </p>
      </section>
    </main>
    <script src="/public/pageTransitions.js"></script>
    <script src="/public/site.js"></script>
  </body>
</html>
