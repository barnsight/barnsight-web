<!doctype html>
<html lang="<%= locale %>">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= t("home.title") %></title>
    <meta name="description" content="<%= t('home.description') %>" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/assets/styles.css" />
  </head>
  <body class="page-transition font-sans">
    <header class="brand-header">
      <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-3 px-6 py-4">
        <a href="/" class="brand-link">
          <img class="brand-logo" src="/assets/brand/logo-t.png" alt="BarnSight logo" />
          <span>BarnSight</span>
        </a>
        <nav class="flex flex-wrap items-center gap-3">
          <a href="#about" class="text-sm font-medium text-zinc-700 hover:text-amber-900"><%= t("nav.about") %></a>
          <a href="#workflow" class="text-sm font-medium text-zinc-700 hover:text-amber-900"><%= t("home.how") %></a>
          <a href="/pricing" class="text-sm font-medium text-zinc-700 hover:text-amber-900"><%= t("nav.pricing") %></a>
          <a href="/faq" class="text-sm font-medium text-zinc-700 hover:text-amber-900"><%= t("nav.faq") %></a>
          <%- include("partials/language-switcher") %>
          <% if (currentUser) { %>
          <a href="/dashboard" class="btn-secondary"><%= t("nav.dashboard") %></a>
          <form action="/logout" method="post">
            <button class="btn-primary" type="submit"><%= t("nav.logout") %></button>
          </form>
          <% } else { %>
          <a href="/register" class="btn-secondary"><%= t("nav.register") %></a>
          <a href="/login" class="btn-primary"><%= t("nav.login") %></a>
          <% } %>
        </nav>
      </div>
    </header>

    <main class="mx-auto max-w-7xl px-6 pb-24 pt-10 sm:pt-14">
      <section class="grid gap-10 lg:grid-cols-[0.94fr_1.06fr] lg:items-center">
        <div class="space-y-8">
          <p class="inline-flex rounded-full border border-amber-800/15 bg-white/75 px-4 py-2 text-xs uppercase tracking-[0.28em] text-amber-900">
            <%= t("home.badge") %>
          </p>
          <div class="space-y-6">
            <h1 class="max-w-4xl text-5xl font-extrabold leading-[0.9] tracking-tight text-zinc-950 sm:text-6xl lg:text-7xl">
              <%= t("home.hero") %>
            </h1>
            <p class="max-w-xl text-lg leading-8 text-zinc-700">
              <%= t("home.lead") %>
            </p>
          </div>
          <div class="flex flex-wrap gap-3">
            <a href="<%= currentUser ? '/dashboard' : '/login' %>" class="btn-primary"><%= currentUser ? t("nav.dashboard") : t("home.cta") %></a>
            <a href="/pricing" class="btn-secondary"><%= t("home.secondaryCta") %></a>
            <a href="/about" class="btn-secondary"><%= t("nav.about") %></a>
          </div>
        </div>

        <section class="relative overflow-hidden rounded-[2.25rem] border border-amber-900/10 bg-white/60 p-4 shadow-2xl shadow-amber-950/10">
          <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_left,rgba(251,191,36,0.18),transparent_35%)]"></div>
          <div class="relative">
            <video
              class="hero-video h-[520px] w-full rounded-[1.75rem] object-cover"
              autoplay
              muted
              loop
              playsinline
              preload="metadata"
              poster="/assets/brand/background.png"
            >
              <source src="/assets/brand/hero-barn.mp4" type="video/mp4" />
            </video>
            <div class="absolute inset-x-5 bottom-5 rounded-[1.5rem] border border-white/50 bg-white/72 p-5 backdrop-blur-xl">
              <div class="flex flex-wrap items-center justify-between gap-3">
                <div>
                  <p class="text-xs uppercase tracking-[0.26em] text-zinc-500">BarnSight</p>
                  <p class="mt-2 text-2xl font-semibold text-zinc-950">Farm hygiene monitoring that stays reviewable.</p>
                </div>
              </div>
            </div>
          </div>
        </section>
      </section>

      <section id="about" class="mt-24 grid gap-8 lg:grid-cols-[0.9fr_1.1fr]">
        <div class="space-y-4">
          <p class="text-sm uppercase tracking-[0.24em] text-zinc-500"><%= t("home.metricsTitle") %></p>
          <h2 class="max-w-xl text-4xl font-bold tracking-tight text-zinc-950 sm:text-5xl"><%= t("home.aboutTitle") %></h2>
        </div>
        <div class="space-y-6">
          <p class="text-lg leading-8 text-zinc-700"><%= t("home.aboutLead") %></p>
          <div class="grid gap-4 sm:grid-cols-3">
            <article class="rounded-[1.75rem] border border-amber-900/10 bg-white/75 p-6 shadow-lg shadow-amber-950/5">
              <p class="text-sm leading-7 text-zinc-700"><%= t("home.aboutPoint1") %></p>
            </article>
            <article class="rounded-[1.75rem] border border-amber-900/10 bg-white/75 p-6 shadow-lg shadow-amber-950/5">
              <p class="text-sm leading-7 text-zinc-700"><%= t("home.aboutPoint2") %></p>
            </article>
            <article class="rounded-[1.75rem] border border-amber-900/10 bg-white/75 p-6 shadow-lg shadow-amber-950/5">
              <p class="text-sm leading-7 text-zinc-700"><%= t("home.aboutPoint3") %></p>
            </article>
          </div>
        </div>
      </section>

      <section id="workflow" class="mt-24">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <div>
            <p class="text-sm uppercase tracking-[0.24em] text-zinc-500"><%= t("home.workflowTitle") %></p>
            <h2 class="mt-3 max-w-3xl text-4xl font-bold tracking-tight text-zinc-950 sm:text-5xl">
              Operational visibility from camera frame to daily report.
            </h2>
          </div>
          <a href="/pricing" class="btn-secondary"><%= t("nav.pricing") %></a>
        </div>
        <div class="mt-10 grid gap-5 lg:grid-cols-3">
          <article class="panel animate-float p-6">
            <p class="text-xs uppercase tracking-[0.24em] text-zinc-500">01</p>
            <h3 class="mt-3 text-xl font-semibold"><%= t("home.step1Title") %></h3>
            <p class="mt-3 text-sm leading-7 text-zinc-700"><%= t("home.step1Body") %></p>
          </article>
          <article class="panel animate-float-delayed p-6">
            <p class="text-xs uppercase tracking-[0.24em] text-zinc-500">02</p>
            <h3 class="mt-3 text-xl font-semibold"><%= t("home.step2Title") %></h3>
            <p class="mt-3 text-sm leading-7 text-zinc-700"><%= t("home.step2Body") %></p>
          </article>
          <article class="panel animate-float p-6">
            <p class="text-xs uppercase tracking-[0.24em] text-zinc-500">03</p>
            <h3 class="mt-3 text-xl font-semibold"><%= t("home.step3Title") %></h3>
            <p class="mt-3 text-sm leading-7 text-zinc-700"><%= t("home.step3Body") %></p>
          </article>
        </div>
      </section>

      <section class="mt-24 grid gap-8 lg:grid-cols-[1.05fr_0.95fr] lg:items-center">
        <div class="space-y-5">
          <p class="text-sm uppercase tracking-[0.24em] text-zinc-500">The future of BarnSight</p>
          <h2 class="max-w-3xl text-4xl font-bold tracking-tight text-zinc-950 sm:text-5xl">A platform that moves from detection to decision support.</h2>
          <p class="text-lg leading-8 text-zinc-700">
            BarnSight is evolving beyond event capture into a fuller operational layer for agricultural hygiene teams. The next phase combines cleaner barn intelligence, coworker workflows, and a more structured review surface for day-to-day decisions.
          </p>
          <p class="text-base leading-8 text-zinc-600">
            The focus remains practical: resilient farm deployment, transparent evidence, and interfaces that help staff react faster without hiding the underlying reality of what cameras and models observed.
          </p>
        </div>
        <article class="panel overflow-hidden p-3">
          <img
            src="/assets/brand/future-barnsight.png"
            alt="Future of BarnSight concept"
            class="h-full min-h-[340px] w-full rounded-[1.75rem] object-cover"
          />
        </article>
      </section>

      <section class="mt-24 rounded-[2.25rem] border border-amber-900/10 bg-zinc-950 px-6 py-10 text-white shadow-2xl shadow-zinc-950/15 sm:px-8">
        <div class="grid gap-8 lg:grid-cols-[1fr_auto] lg:items-end">
          <div>
            <p class="text-sm uppercase tracking-[0.24em] text-white/45"><%= t("footer.product") %></p>
            <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">BarnSight</h2>
            <p class="mt-4 max-w-3xl text-sm leading-7 text-white/70">
              BarnSight develops computer vision systems for agricultural hygiene monitoring. The platform combines edge detection,
              centralized ingestion, and structured review so teams can operate cleaner, safer facilities without adding friction to field work.
            </p>
          </div>
          <div class="flex flex-wrap gap-3">
            <a href="https://github.com/barnsight" target="_blank" rel="noreferrer" class="btn-secondary border-white/20 bg-white/10 text-white">GitHub</a>
            <a href="/faq" class="btn-secondary border-white/20 bg-white/10 text-white"><%= t("nav.faq") %></a>
            <a href="/pricing" class="btn-primary"><%= t("nav.pricing") %></a>
          </div>
        </div>
        <footer class="mt-8 grid gap-3 border-t border-white/10 pt-5 text-sm text-white/55 md:grid-cols-4">
          <p><%= t("footer.product") %> · BarnSight</p>
          <p><%= t("footer.company") %> · Horizon Farm Analytics</p>
          <p><%= t("footer.contact") %> · ops@barnsight.local</p>
          <a href="https://github.com/barnsight" target="_blank" rel="noreferrer" class="transition hover:text-white">github.com/barnsight</a>
        </footer>
      </section>
    </main>

    <script src="/public/pageTransitions.js"></script>
  </body>
</html>
