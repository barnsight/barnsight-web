{
  "name": "barnsight-ua-web",
  "version": "1.0.0",
  "private": true,
  "description": "Ukrainian BarnSight website with monochrome Tailwind UI and Node.js proxy",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently \"npm:dev:css\" \"npm:dev:server\"",
    "dev:server": "node --watch server/index.js",
    "dev:css": "tailwindcss -i ./src/input.css -o ./public/assets/styles.css --watch",
    "build": "tailwindcss -i ./src/input.css -o ./public/assets/styles.css --minify",
    "start": "node server/index.js"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "ejs": "^3.1.10",
    "express": "^5.1.0",
    "express-session": "^1.18.2"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17"
  }
}
